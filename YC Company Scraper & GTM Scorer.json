    {
      "parameters": {
        "jsCode": "\nreturn $input.all().map(function(item) {\n  var c = item.json;\n  var score = 0;\n  var tags = Array.isArray(c.tags) ? c.tags.join(', ').toLowerCase() : String(c.tags || '').toLowerCase();\n  var industry = String(c.industry || '').toLowerCase();\n  var size = parseInt(c.team_size) || 0;\n  if (size >= 15 && size <= 80) score += 15;\n  if (c.isHiring === false || c.isHiring === 'No') score += 20;\n  if (tags.indexOf('sales') > -1 || tags.indexOf('crm') > -1 || tags.indexOf('revenue') > -1) score += 20;\n  if (tags.indexOf('b2b') > -1 && tags.indexOf('saas') > -1) score += 15;\n  if (tags.indexOf('automation') > -1 || tags.indexOf('analytics') > -1) score += 10;\n  if (industry.indexOf('fintech') > -1 || industry.indexOf('hr') > -1 || industry.indexOf('enterprise') > -1) score += 10;\n  var finalScore = Math.min(score, 100);\n  var icpFit = finalScore >= 60 ? 'High' : finalScore >= 35 ? 'Medium' : 'Low';\n  var priority = finalScore >= 60 ? '1' : finalScore >= 35 ? '2' : '3';\n  var tagsStr = Array.isArray(c.tags) ? c.tags.join(', ') : String(c.tags || '');\n  var regionsStr = Array.isArray(c.regions) ? c.regions.join(', ') : String(c.regions || '');\n\n  return {\n    json: {\n      'Company Name': c.name || '',\n      'YC Slug': c.slug || '',\n      'Batch': c.batch || '',\n      'Status': c.status || '',\n      'Team Size': size,\n      'Industry': c.industry || '',\n      'Sub-industry': c.subindustry || '',\n      'Tags': tagsStr,\n      'Is Hiring': c.isHiring === true ? 'Yes' : c.isHiring === false ? 'No' : '',\n      'Stage': c.stage || '',\n      'Top Company': c.top_company === true ? 'Yes' : '',\n      'Website': c.website || '',\n      'YC Profile URL': c.url || ('https://www.ycombinator.com/companies/' + (c.slug || '')),\n      'LinkedIn URL': c.linkedin_url || '',\n      'Crunchbase URL': c.cb_url || '',\n      'Regions': regionsStr,\n      'HubSpot?': '',\n      'Intercom?': '',\n      'Segment?': '',\n      'Mixpanel?': '',\n      'GA4?': '',\n      'Drift?': '',\n      'Apollo?': '',\n      'SalesLoft?': '',\n      'Open Roles': '',\n      'GTM Roles': '',\n      'Latest GTM Role': '',\n      'Days Since Post': '',\n      'GTM Gap Score': finalScore,\n      'ICP Fit': icpFit,\n      'Priority': priority,\n      'One-Liner': c.one_liner || '',\n      'AI Hook': '',\n      'Outreach Status': 'Not Started',\n      'Contact LinkedIn': '',\n      'Notes': '',\n      _name: c.name || '',\n      _one_liner: c.one_liner || '',\n      _tags: tagsStr,\n      _team_size: size,\n      _gtm_score: finalScore\n    }\n  };\n});\n"
      },
      "id": "b7d1b425-9b84-4312-a412-09b3fc901a49",
      "name": "Compute GTM Gap Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        192
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nvar c = $input.item.json;\nvar body = {\n  model: 'anthropic/claude-haiku-4.5',\n  max_tokens: 120,\n  messages: [\n    { role: 'system', content: 'You write ultra-short cold email openers (1 sentence max). You are Saswati, a GTM Engineer. Be specific, human, no buzzwords.' },\n    { role: 'user', content: 'Company: ' + c._name + '. What they do: ' + c._one_liner + '. Tags: ' + c._tags + '. Team: ' + c._team_size + ' people. GTM score: ' + c._gtm_score + '/100. Write one sentence.' }\n  ]\n};\nreturn { json: { ...c, _hook_body: JSON.stringify(body) } };\n"
      },
