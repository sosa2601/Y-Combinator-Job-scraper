      "id": "7e5f6120-0760-4ca0-9314-a5489360125d",
      "name": "Read Existing Slugs from Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        672,
        192
      ],
      "executeOnce": true,
      "alwaysOutputData": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "gFHCIe3QxodFLCCc",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\nlet existingSlugs = new Set();\ntry {\n  const sheetRows = $('Read Existing Slugs from Sheet').all();\n  for (const row of sheetRows) {\n    const slug = row.json['YC Slug'] || '';\n    if (slug) existingSlugs.add(String(slug).trim().toLowerCase());\n  }\n} catch(e) {}\nconst filtered = $('Filter by ICP Criteria').all();\nconst newCompanies = filtered.filter(item => {\n  const slug = String(item.json.slug || '').trim().toLowerCase();\n  return slug && !existingSlugs.has(slug);\n});\nreturn newCompanies.map(item => ({ json: item.json }));\n"
      },
