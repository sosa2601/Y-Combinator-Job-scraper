    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nvar item = $input.item.json;\nvar hookText = '';\ntry { hookText = (item.choices[0].message.content || '').trim(); } catch(e) {}\nreturn {\n  json: {\n    'Company Name': item['Company Name'] || '',\n    'YC Slug': item['YC Slug'] || '',\n    'Batch': item['Batch'] || '',\n    'Status': item['Status'] || '',\n    'Team Size': item['Team Size'] || '',\n    'Industry': item['Industry'] || '',\n    'Sub-industry': item['Sub-industry'] || '',\n    'Tags': item['Tags'] || '',\n    'Is Hiring': item['Is Hiring'] || '',\n    'Stage': item['Stage'] || '',\n    'Top Company': item['Top Company'] || '',\n    'Website': item['Website'] || '',\n    'YC Profile URL': item['YC Profile URL'] || '',\n    'LinkedIn URL': item['LinkedIn URL'] || '',\n    'Crunchbase URL': item['Crunchbase URL'] || '',\n    'Regions': item['Regions'] || '',\n    'HubSpot?': '',\n    'Intercom?': '',\n    'Segment?': '',\n    'Mixpanel?': '',\n    'GA4?': '',\n    'Drift?': '',\n    'Apollo?': '',\n    'SalesLoft?': '',\n    'Open Roles': '',\n    'GTM Roles': '',\n    'Latest GTM Role': '',\n    'Days Since Post': '',\n    'GTM Gap Score': item['GTM Gap Score'] || '',\n    'ICP Fit': item['ICP Fit'] || '',\n    'Priority': item['Priority'] || '',\n    'One-Liner': item['One-Liner'] || '',\n    'AI Hook': hookText,\n    'Outreach Status': 'Not Started',\n    'Contact LinkedIn': '',\n    'Notes': ''\n  }\n};\n"
      },
