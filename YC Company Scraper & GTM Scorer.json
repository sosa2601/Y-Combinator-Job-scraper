    {
      "parameters": {
        "jsCode": "\nconst TARGET_TAGS = new Set(['b2b','saas','sales','marketing','analytics','crm','enterprise','ai','automation','fintech','hr tech','developer tools','revenue']);\nconst allItems = $input.all();\nconst filtered = allItems.filter(item => {\n  const c = item.json;\n  if (!c || !c.name) return false;\n  if (c.status === 'Inactive' || c.status === 'Dead') return false;\n  const size = parseInt(c.team_size) || 0;\n  if (size < 10 || size > 150) return false;\n  const tags = Array.isArray(c.tags) ? c.tags.map(t => String(t).toLowerCase()) : [];\n  return tags.some(t => TARGET_TAGS.has(t));\n});\nreturn filtered.map(item => ({ json: item.json }));\n"
      },
      "id": "8c3a7244-4537-4e63-b013-bfe4bfd66e5f",
      "name": "Filter by ICP Criteria",
      "type": "n8n-nodes-base.code",
